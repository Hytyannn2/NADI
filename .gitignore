# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dialect engine runtime files
dialect-engine/learned_mappings.json
dialect-engine/clusters.json
dialect-engine/feedback_log.jsonl
dialect-engine/__pycache__/

# Firmware & Arduino Sketches
/firmware/
*.ino

# Secrets / Credentials (NEVER commit these)
secrets.h

# Media & Heavy User Assets (Ignore raw/temp uploads, keep public web assets)
*.mp4
*.webm
*.mov
*.psd
*.ai

# Ensure public UI brand assets & favicons ARE tracked by Git
!public/**
!src/app/icon.jpg
!src/app/icon.png

# Python Virtual Environments & Tooling Caches (HIGHLY RECOMMENDED)
.venv/
venv/
env/
/strix-env/
/strix_runs/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Local IDE / Editor Settings
.vscode/
.idea/
*.swp
*.swo

# Internal Scratch Plans & Markdown Notes
gamification_plan.md
neural_network_plan.md
maps_files.md
*_plan.md