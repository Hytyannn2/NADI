# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dialect engine runtime files
dialect-engine/learned_mappings.json
dialect-engine/clusters.json
dialect-engine/feedback_log.jsonl
dialect-engine/__pycache__/

# Firmware & Arduino Sketches
/firmware/
*.ino

# Secrets / Credentials (NEVER commit these)
secrets.h

# Media & Image Assets
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.mp4
*.webm
*.mov
!public/icon.svg
!public/globe.svg
!public/file.svg
!public/window.svg
