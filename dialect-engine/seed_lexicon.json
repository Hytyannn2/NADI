  "phonetic_rules": {
    "kelantan": [
      { "pattern": "gh", "replacement": "r", "position": "any", "description": "Aspirated R" },
      { "pattern": "o$", "replacement": "a", "position": "end", "description": "Terminal vowel shift O→A" },
      { "pattern": "e$", "replacement": "a", "position": "end", "description": "Terminal vowel shift E→A" },
      { "pattern": "^bb", "replacement": "b", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^jj", "replacement": "j", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^ll", "replacement": "l", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^cc", "replacement": "c", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^dd", "replacement": "d", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^tt", "replacement": "t", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^gg", "replacement": "g", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^kk", "replacement": "k", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^mm", "replacement": "m", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^nn", "replacement": "n", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^pp", "replacement": "p", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^ss", "replacement": "s", "position": "start", "description": "Geminate consonant" },
      { "pattern": "^rh", "replacement": "r", "position": "start", "description": "Aspirated R variant" },
      { "pattern": "ang$", "replacement": "an", "position": "end", "description": "Nasal ending shift" }
    ],
    "terengganu": [
      { "pattern": "ang$", "replacement": "an", "position": "end", "description": "Nasal ending -ang" },
      { "pattern": "o$", "replacement": "a", "position": "end", "description": "Terminal vowel shift" },
      { "pattern": "ogh", "replacement": "or", "position": "any", "description": "Aspirated R variant" }
    ],
    "kedah": [
      { "pattern": "q$", "replacement": "k", "position": "end", "description": "Glottal stop" },
      { "pattern": "^tok", "replacement": "tak", "position": "start", "description": "Negation form" }
    ]
  }
